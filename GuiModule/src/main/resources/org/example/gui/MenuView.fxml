<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane fx:id="mainPane" xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/21.0.7"
            fx:controller="org.example.gui.MenuViewController"
            stylesheets="@styles.css">

    <left>
        <VBox styleClass="menu-button" spacing="10" style="-fx-background-color: #2c2f3a; -fx-padding: 40;">
            <Button fx:id="mainButton" text="Main" onAction="#onMainButtonClicked" styleClass="menu-btn" />
            <Button fx:id="addToyButton" text="Add Toy" onAction="#onAddToy" styleClass="menu-btn" />
            <Button fx:id="editBudgetButton" text="Edit Budget" onAction="#handleEditBudget" styleClass="menu-btn" />

            <Region VBox.vgrow="ALWAYS" />

            <VBox fx:id="budgetDisplayBox" alignment="BOTTOM_LEFT" spacing="5" styleClass="budget-box">
                <Label text="Budget:" styleClass="budget-title"/>
                <Label fx:id="budgetLabel" text=" " styleClass="budget-value"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentPane"/>
    </center>

</BorderPane>
