<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane fx:id="mainPane" xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/21.0.7"
            fx:controller="org.example.gui.MainViewController">

    <left>
        <VBox spacing="10" style="-fx-background-color: #2c2f3a; -fx-padding: 20;">
            <Button text="Add Toy" onAction="#onAddToy" style="-fx-text-fill: white; -fx-background-color: transparent;" />
            <Button text="Read File" onAction="#onReadFile" style="-fx-text-fill: white; -fx-background-color: transparent;" />
            <Button text="Find Toy" onAction="#onFindToy" style="-fx-text-fill: white; -fx-background-color: transparent;" />
            <Button text="Sort Toys" onAction="#onSortToys" style="-fx-text-fill: white; -fx-background-color: transparent;" />
            <Button text="Delete Toy" onAction="#onDeleteToy" style="-fx-text-fill: white; -fx-background-color: transparent;" />
            <Button text="Exit" onAction="#onExit" style="-fx-text-fill: white; -fx-background-color: transparent;" />
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentPane"/>
    </center>

</BorderPane>
