<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:controller="org.example.gui.AddToyController"
            xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21.0.7"
            stylesheets="@styles.css">

    <center>
        <VBox spacing="10" alignment="CENTER" maxWidth="300">
            <padding>
                <Insets top="40" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Add New Toy" styleClass="form-title"/>

            <TextField fx:id="typeField" promptText="Type" styleClass="form-field"/>
            <TextField fx:id="sizeField" promptText="Size" styleClass="form-field"/>
            <TextField fx:id="colorField" promptText="Color" styleClass="form-field"/>
            <TextField fx:id="materialField" promptText="Material" styleClass="form-field"/>
            <TextField fx:id="priceField" promptText="Price" styleClass="form-field"/>

            <Button text="Add Toy" onAction="#handleAddToy" styleClass="form-button"/>
        </VBox>
    </center>
</BorderPane>
