<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox fx:controller="org.example.gui.SortViewController"
      spacing="10" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21.0.7"
      prefHeight="600" prefWidth="800"
      stylesheets="@styles.css">

    <padding>
        <Insets top="10" right="0" bottom="0" left="0"/>
    </padding>

    <Label text="Sort Toys" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <HBox spacing="10">
        <Label text="Sort by:"/>
        <ComboBox fx:id="sortComboBox" promptText="Choose sort method" onAction="#onSortChanged"/>
    </HBox>

    <TableView fx:id="toyTable" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn text="Type" fx:id="typeCol"/>
            <TableColumn text="Size" fx:id="sizeCol"/>
            <TableColumn text="Color" fx:id="colorCol"/>
            <TableColumn text="Material" fx:id="materialCol"/>
        </columns>
    </TableView>
</VBox>
